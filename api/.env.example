# Copiar a api/.env y completar. api/.env NO se versiona.

# Puerto HTTP de la API
PORT=3000

# Origen permitido por CORS (el frontend de Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL (Postgres.app, puerto 5433) con el usuario de la aplicación.
# idepy_app tiene solo permisos de lectura sobre el esquema idepy.
PGHOST=localhost
PGPORT=5433
PGDATABASE=idepy_demo
PGUSER=idepy_app
PGPASSWORD=cambiar_esta_contrasena
